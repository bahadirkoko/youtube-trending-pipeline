# Copy to .env and fill in. .env is gitignored, so never commit real values.
#
# Local use only (for example, trying the YouTube API from a notebook).
# The deployed pipeline does NOT read this file: the ingestion Lambda gets the key
# from Secrets Manager. Store it there with `make set-secret`.

# YouTube Data API v3 key from https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=
