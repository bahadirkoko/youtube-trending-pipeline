# ============================================================
# Terraform
# ============================================================
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
# Real variable files may hold secrets/account IDs; commit only the examples
*.tfvars
*.tfvars.json
!*.tfvars.example
# NOTE: .terraform.lock.hcl is intentionally NOT ignored. Commit it.

# ============================================================
# Python
# ============================================================
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ============================================================
# Lambda / Glue packaging artifacts (built by Terraform or scripts)
# ============================================================
*.zip
*.whl
.build/
package/

# ============================================================
# Secrets and credentials - NEVER commit
# ============================================================
.env
.env.*
!.env.example
*.pem
*.key
secrets*
.aws/
credentials
*.credentials

# ============================================================
# Data (keep small reference files; ignore bulk data)
# ============================================================
data/sample/*.csv
data/raw/
data/tmp/
*.parquet
*.csv.gz
!data/reference/*.json

# ============================================================
# Jupyter
# ============================================================
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# ============================================================
# OS / IDE
# ============================================================
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json.example
*.swp
*.swo
*~